# Settings read from environment variables. The scripts don't load a .env file,
# so export them in your shell (e.g. `export WAYMO_DATA_DIR=~/waymo-data`).
# No secrets or keys are needed for the local pipeline.

# Folder that holds motion/ and reasoning/ (see data/README.md). Default: ./data
WAYMO_DATA_DIR=data

# Only for the optional gcp_implementation/ sketches (not run or tested):
# GOOGLE_CLOUD_PROJECT=your-project-id
